{"t0":5634,"t1":5738,"voice":0,"quoted":false,"pitch":0,"dist":0.000,"text":" You're not going crazy.","tokens":[921,821,407,1016,7165,13,51747]}
{"t0":5738,"t1":5970,"voice":0,"quoted":false,"pitch":0,"dist":0.000,"text":" Your grandfather really was a peacemaker.","tokens":[50363,3406,17695,1107,373,257,41961,32174,13,50479]}
{"t0":5970,"t1":6382,"voice":0,"quoted":false,"pitch":0,"dist":0.000,"text":" He believed right down to the core of his being and protecting those who couldn't protect","tokens":[679,4762,826,866,284,262,4755,286,465,852,290,10192,883,508,3521,470,1805,50685]}

{"t0":9422,"t1":9622,"voice":0,"quoted":false,"pitch":0,"dist":0.000,"text":" I gestured elaborately toward the ship.","tokens":[314,10521,1522,12628,1286,3812,262,4074,13,50855]}
{"t0":9622,"t1":9914,"voice":0,"quoted":true,"pitch":0,"dist":0.000,"text":" \"After you, my good bird.\"","tokens":[366,3260,345,11,616,922,6512,526,51001]}

{"t0":7298,"t1":7746,"voice":0,"quoted":true,"pitch":0,"dist":0.000,"text":" \"You expect me to believe that my grandfather was a star-faring soldier?","tokens":[366,1639,1607,502,284,1975,326,616,17695,373,257,3491,12,69,1723,10686,30,51367]}
